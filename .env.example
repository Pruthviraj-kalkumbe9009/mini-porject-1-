NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/smart_scheduler
CLIENT_ORIGIN=http://127.0.0.1:5500
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Required in production to create the first administrator.
ADMIN_EMAIL=admin@your-institution.edu
ADMIN_PASSWORD=replace-with-a-strong-password
